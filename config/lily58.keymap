#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        // Macro for vim register access: " followed by +
        vim_reg: vim_reg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp PLUS>;
        };
    };

    behaviors {
        // Tap for COLON, hold for LOWER layer
        colon_lower: colon_lower {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
        
        // Tap for BSPC, hold for RAISE layer
        bspc_raise: bspc_raise {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Tap for BSLH, hold for VIM layer
        bslh_vim: bslh_vim {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // | CAPS  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | :/LWR | SPACE |  | ENTER |BSPC/RSE| CTRL | RGUI  |

            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                       &kp N6  &kp N7             &kp N8     &kp N9     &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                                        &kp Y   &kp U              &kp I      &kp O      &kp P     &kp MINUS
&kp CLCK   &kp A   &kp S   &kp D     &kp F     &kp G                                        &kp H   &kp J              &kp K      &kp L      &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LCTRL      &kp RCTRL             &kp N   &kp M              &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
                           &kp LALT  &kp LGUI  &colon_lower 1 COLON  &kp SPACE    &kp RET  &bspc_raise 2 BSPC  &bslh_vim 4 BSLH  &kp RGUI
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   | F10  |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   | INS  | DEL   | HOME  | END  | PGUP  | PGDN  |
            // |       |  [  |  ]  |  {   |  }   |  \   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  =   |   |   |  "|"  |
            //                     |      |      | HOLD |        |  |       | ADJ  |       |       |

            display-name = "Lower";
            bindings = <
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                          &kp F7     &kp F8     &kp F9           &kp F10    &kp F11   &kp F12
&kp GRAVE   &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT                       &kp INS    &kp DEL    &kp HOME         &kp END    &kp PG_UP &kp PG_DN
&trans      &kp LBKT      &kp RBKT      &kp LBRC      &kp RBRC      &kp BSLH                        &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR   &kp RPAR  &kp TILDE
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans     &kp MINUS  &kp PLUS         &kp EQUAL  &kp PIPE  &kp PIPE
                                        &trans        &trans        &trans        &trans    &trans  &mo 3      &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       | "+  |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |  UP   |      |       |       |
            // |       | GUI | ALT | CTRL | SHFT |      |                   |      | LEFT  | DOWN  | RIGHT|       |       |
            // |       |     |     |      |      |      |        |  |       |      | HOME  | PGDN  | PGUP | END   |       |
            //                     | RALT |      | ADJ  |        |  |       | HOLD |       |       |

            display-name = "Raise";
            bindings = <
&trans  &trans    &trans    &trans    &trans     &trans                      &trans  &trans    &trans     &trans     &trans   &trans
&trans  &trans    &trans    &trans    &trans     &trans                      &trans  &trans    &kp UP     &trans     &trans   &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL &kp LSHFT  &trans                      &trans  &kp LEFT  &kp DOWN   &kp RIGHT  &trans   &trans
&trans  &trans    &trans    &trans    &trans     &trans  &trans    &trans    &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &trans
                            &sk RALT  &trans     &mo 3   &trans    &trans    &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |        |  |       |      |       |       |      |       |       |
            //                     |      |      | HOLD |        |  | HOLD  |      |       |       |

            display-name = "Adjust";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans
            >;
        };

        vim_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |WORD→|      |      |      |                   | REDO | UNDO  | C-UP  |      | PASTE |       |
            // |       | ALL | SAVE| DEFN |FUZZY |      |                   |      |C-LEFT |C-DOWN |C-RGHT|       |       |
            // |       | UNDO| CUT | COPY |PASTE |WORD← |        |  |       |RENAME| HOME  | PGDN  | PGUP | END   |       |
            //                     |      |      |      |        |  |       | HOLD |       |       |

            display-name = "Vim";
            bindings = <
&trans  &vim_reg  &trans        &trans    &trans     &trans                          &trans     &trans        &trans       &trans         &trans   &trans
&trans  &trans    &kp LC(RIGHT) &trans    &trans     &trans                          &kp LC(Y)  &kp LC(Z)     &kp LC(UP)   &trans         &kp LC(V) &trans
&trans  &kp LC(A) &kp LC(S)     &kp F12   &kp LC(P)  &trans                          &trans       &kp LC(LEFT) &kp LC(DOWN) &kp LC(RIGHT)  &trans   &trans
&trans  &kp LC(Z) &kp LC(X)     &kp LC(C) &kp LC(V)  &kp LC(LEFT)  &trans    &trans  &kp F2     &kp HOME      &kp PG_DN    &kp PG_UP      &kp END  &trans
                                &trans    &trans     &trans        &trans    &trans  &trans     &trans        &trans
            >;
        };

        extra_2 { status = "reserved"; };
    };
};
